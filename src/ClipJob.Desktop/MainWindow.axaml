<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ClipJob.Desktop"
        x:Class="ClipJob.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="ClipJob"
        Width="660"
        Height="440"
        MinWidth="560"
        MinHeight="360"
        MaxWidth="960"
        MaxHeight="720"
        CanResize="True"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_OnKeyDown">
  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="Button.delete-action">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.delete-action:pointerover">
      <Setter Property="Background" Value="#B52A1D" />
    </Style>
    <Style Selector="Button.delete-action:pressed">
      <Setter Property="Background" Value="#A4262C" />
    </Style>
    <Style Selector="Button.edit-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="Button.edit-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
  </Window.Styles>

  <Border Margin="12"
          Padding="16"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1"
          CornerRadius="12"
          BoxShadow="0 10 28 0 #66000000">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
    <Grid Grid.Row="0"
          Height="30"
          Margin="2,-3,2,-1"
          ColumnDefinitions="*,Auto"
          Background="Transparent"
          Cursor="SizeAll"
          PointerPressed="DragRegion_OnPointerPressed">
      <StackPanel Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="8"
                  IsHitTestVisible="False">
        <Border Width="22"
                Height="22"
                Background="{DynamicResource SystemControlHighlightListAccentLowBrush}"
                CornerRadius="6">
          <TextBlock Text="C"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="12"
                     FontWeight="Bold" />
        </Border>
        <TextBlock Text="ClipJob"
                   VerticalAlignment="Center"
                   FontSize="14"
                   FontWeight="SemiBold" />
      </StackPanel>
      <TextBlock Grid.Column="1"
                 Text="⠿"
                 VerticalAlignment="Center"
                 FontSize="18"
                 Opacity="0.42"
                 IsHitTestVisible="False" />
    </Grid>

    <Grid Grid.Row="1">
      <TextBox x:Name="SearchTextBox"
               Text="{Binding Query}"
               PlaceholderText="Search clips by label or content…"
               FontSize="18"
               Padding="40,11,54,11"
               KeyDown="SearchTextBox_OnKeyDown" />
      <Path Width="18"
            Height="18"
            Margin="14,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Data="M 7,1 A 6,6 0 1 0 7,13 A 6,6 0 1 0 7,1 M 11.5,11.5 L 16,16"
            Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            StrokeThickness="1.5"
            IsHitTestVisible="False" />
      <Border Margin="0,0,12,0"
              Padding="5,2"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="4"
              IsHitTestVisible="False">
        <TextBlock Text="esc" FontSize="11" Opacity="0.62" />
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <ListBox x:Name="ResultsListBox"
               ItemsSource="{Binding VisibleClips}"
               SelectedItem="{Binding SelectedClip}"
               Background="Transparent"
               BorderThickness="0"
               SelectionChanged="ResultsListBox_OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:Clip">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="3">
                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1"
                           Text="{Binding Content}"
                           FontSize="12.5"
                           Opacity="0.64"
                           MaxLines="2"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          VerticalAlignment="Center"
                          Spacing="4">
                <Button Width="30"
                        Height="28"
                        Classes="edit-action"
                        Padding="0"
                        Click="EditClip_OnClick"
                        ToolTip.Tip="Edit clip"
                        AutomationProperties.Name="Edit clip">
                  <Path Width="15"
                        Height="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Data="M 3,13 L 4,9 L 12,1 L 15,4 L 7,12 Z M 10.5,2.5 L 13.5,5.5"
                        Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        StrokeThickness="1.4"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                </Button>
                <Button Width="30"
                        Height="28"
                        Classes="delete-action"
                        Padding="0"
                        Click="DeleteClip_OnClick"
                        ToolTip.Tip="Delete clip"
                        AutomationProperties.Name="Delete clip">
                  <Path Width="15"
                        Height="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Data="M 6,19 C 6,20.1 6.9,21 8,21 L 16,21 C 17.1,21 18,20.1 18,19 L 18,7 L 6,7 Z M 8.5,9 L 10,9 L 10,19 L 8.5,19 Z M 14,9 L 15.5,9 L 15.5,19 L 14,19 Z M 15.5,4 L 14.5,3 L 9.5,3 L 8.5,4 L 5,4 L 5,6 L 19,6 L 19,4 Z"
                        Fill="White" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel IsVisible="{Binding HasNoClips}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock Text="No clips yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Create your first reusable clip to get started."
                   Opacity="0.64"
                   HorizontalAlignment="Center" />
        <Button Content="Create first clip"
                HorizontalAlignment="Center"
                Padding="12,6"
                Click="AddClip_OnClick" />
      </StackPanel>

      <StackPanel IsVisible="{Binding HasNoSearchResults}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock Text="{Binding NoResultsMessage}"
                   FontSize="17"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Try a different label or phrase."
                   Opacity="0.64"
                   HorizontalAlignment="Center" />
        <Button Content="Clear search"
                HorizontalAlignment="Center"
                Padding="12,6"
                Click="ClearSearch_OnClick" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock VerticalAlignment="Center"
                 Opacity="0.58"
                 FontSize="12"
                 Text="↑↓ Select    ↵ Paste    ⌘N New    ⌘E Edit    ⌘⌫ Delete" />
      <Button Grid.Column="1" Content="New clip" Click="AddClip_OnClick" Padding="11,5" />
    </Grid>
  </Grid>
  </Border>
</Window>
