<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ClipJob.Desktop"
        x:Class="ClipJob.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="ClipJob"
        Width="660"
        Height="460"
        MinWidth="560"
        MinHeight="360"
        MaxWidth="760"
        MaxHeight="600"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_OnKeyDown">
  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>

  <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <TextBox x:Name="SearchTextBox"
             Grid.Row="0"
             Text="{Binding Query}"
             PlaceholderText="Search clips..."
             FontSize="17"
             Padding="12,10"
             KeyDown="SearchTextBox_OnKeyDown" />

    <Grid Grid.Row="1">
      <ListBox x:Name="ResultsListBox"
               ItemsSource="{Binding VisibleClips}"
               SelectedItem="{Binding SelectedClip}"
               SelectionChanged="ResultsListBox_OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:Clip">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="3">
              <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1"
                         Text="{Binding Content}"
                         FontSize="13"
                         Opacity="0.68"
                         MaxLines="2"
                         TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel IsVisible="{Binding HasNoResults}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="6">
        <TextBlock Text="No clips found" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="⌘N to create a clip" Opacity="0.6" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock VerticalAlignment="Center"
                 Opacity="0.58"
                 FontSize="12"
                 Text="↑↓ Navigate    ↵ Paste    ⌘N New    ⌘E Edit" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Content="New" Click="AddClip_OnClick" Padding="10,5" />
        <Button Content="Edit" Click="EditClip_OnClick" IsEnabled="{Binding HasSelection}" Padding="10,5" />
        <Button Content="Delete" Click="DeleteClip_OnClick" IsEnabled="{Binding HasSelection}" Padding="10,5" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
