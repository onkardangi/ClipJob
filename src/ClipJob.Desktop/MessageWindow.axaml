<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipJob.Desktop.MessageWindow" Width="380" Height="160"
        CanResize="False" WindowStartupLocation="CenterOwner" Title="ClipJob">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock x:Name="Message" TextWrapping="Wrap" />
    <Button Content="OK" HorizontalAlignment="Right" Click="Ok_OnClick" />
  </StackPanel>
</Window>
