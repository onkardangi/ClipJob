<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipJob.Desktop.ConfirmationWindow" Width="400" Height="210"
        CanResize="False" WindowStartupLocation="CenterOwner" Title="Delete Clip"
        KeyDown="Window_OnKeyDown">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
    <TextBlock x:Name="Question"
               FontSize="20"
               FontWeight="SemiBold"
               TextWrapping="Wrap" />
    <TextBlock Grid.Row="1"
               Text="This clip will be permanently removed. This action cannot be undone."
               TextWrapping="Wrap"
               Opacity="0.68" />
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
      <Button x:Name="CancelButton"
              Content="Cancel"
              MinWidth="82"
              Padding="12,6"
              Click="Cancel_OnClick" />
      <Button Grid.Column="2"
              Content="Delete clip"
              MinWidth="96"
              Padding="12,6"
              Background="#C42B1C"
              Foreground="White"
              Click="Delete_OnClick" />
    </Grid>
  </Grid>
</Window>
