<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipJob.Desktop.ConfirmationWindow" Width="380" Height="190"
        CanResize="False" WindowStartupLocation="CenterOwner" Title="Delete Clip">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="Question" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="This cannot be undone." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="Cancel_OnClick" />
      <Button Content="Delete" Click="Delete_OnClick" />
    </StackPanel>
  </StackPanel>
</Window>
