<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipJob.Desktop.ClipEditorWindow"
        Width="460" Height="360" CanResize="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">
    <TextBlock x:Name="Heading" Grid.Row="0" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Text="Label" />
    <TextBox x:Name="LabelTextBox" Grid.Row="2" />
    <StackPanel Grid.Row="3" Spacing="8">
      <TextBlock Text="Content" />
      <TextBox x:Name="ContentTextBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock x:Name="ValidationMessage" Grid.Row="4" Foreground="Crimson" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="Cancel_OnClick" />
      <Button Content="Save" Click="Save_OnClick" />
    </StackPanel>
  </Grid>
</Window>
